# Server-only values. Never use NEXT_PUBLIC_ for credentials.
OPENAI_API_KEY=
OPENROUTER_API_KEY=
LOCAL_LLM_BASE_URL=
LOCAL_LLM_API_KEY=
VISION_MODEL=
# OpenAI-compatible embeddings endpoint, e.g. your local embedding server /v1
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=
EMBEDDING_IS_LOCAL=false
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=knowledge
# PostgreSQL connection (initialize schema in database/postgresql.sql)
DATABASE_URL=
# pg for regular PostgreSQL; neon for Neon HTTP
DATABASE_DRIVER=pg
# Local demo metadata and uploads; these are ignored by Git.
LOCAL_DATA_PATH=./data
LOCAL_STORAGE_PATH=./data/uploads
# Optional Azure Blob storage, takes priority over local uploads.
AZURE_BLOB_CONTAINER_URL=
AZURE_BLOB_SAS_TOKEN=
